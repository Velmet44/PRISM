{
  "$ref": "#/definitions/workspace-manifest",
  "definitions": {
    "workspace-manifest": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mtime_ns": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "sha256",
          "size",
          "mtime_ns"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "minLength": 1
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
