{
  "$ref": "#/definitions/ws-ticket-issuance",
  "definitions": {
    "ws-ticket-issuance": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_secret": {
          "type": "string",
          "minLength": 1
        },
        "ticket_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "ticket_id",
        "ticket_secret",
        "ticket_sha256",
        "nonce",
        "expires_at",
        "scopes"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
