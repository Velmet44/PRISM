{
  "$ref": "#/definitions/proof-doc",
  "definitions": {
    "proof-doc": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "description": "NodeId"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "SessionId"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "description": "DeviceId"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_type": {
          "type": "string"
        },
        "content_encoding": {
          "type": "string",
          "enum": [
            "identity",
            "gzip",
            "br"
          ]
        },
        "iat": {
          "type": "integer",
          "minimum": 0
        },
        "jti": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "token_sha256": {
          "$ref": "#/definitions/proof-doc/properties/body_sha256"
        }
      },
      "required": [
        "v",
        "node_id",
        "session_id",
        "device_id",
        "method",
        "target",
        "body_sha256",
        "content_type",
        "content_encoding",
        "iat",
        "jti",
        "token_sha256"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
