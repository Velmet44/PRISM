  "dependencies": {
    "@prism/protocol": "workspace:*",
    "@prism/schemas": "workspace:*",
    "@prism/shared": "workspace:*",
    "hash-wasm": "^4.12.0",
    "kysely": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
